---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Process from "../components/Process.astro";
import Stats from "../components/Stats.astro";
import Estimator from "../components/Estimator.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import StickyCTA from "../components/StickyCTA.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Constructora Andina | Construimos espacios que trascienden" description="Constructora en Tarapoto: edificaciones residenciales y comerciales con control de calidad, seguridad en obra y transparencia de costos.">
  <Header />
  <main id="contenido">
    <Hero />
    <TrustBar />
    <Services />
    <Projects />
    <Process />
    <Stats />
    <Estimator />
    <Testimonials />
    <FAQ />
    <Contact />
  </main>
  <StickyCTA />
  <Footer />
</BaseLayout>
