---
---
<section class="relative flex items-center overflow-hidden pt-24 pb-20 md:pt-32 md:pb-28">
  <!-- Fondo -->
  <div class="absolute inset-0 -z-10">
    <img
      src="/images/hero.avif"
      alt="Obra moderna de Constructora Andina"
      class="w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <!-- Degradado sutil -->
    <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/70 to-transparent dark:from-slate-950/90 dark:via-slate-950/70 dark:to-transparent"></div>
    <img src="/images/pattern-bg.svg" alt="" aria-hidden="true"
         class="absolute inset-0 opacity-10 mix-blend-overlay" />
  </div>

  <div class="container">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <!-- Texto -->
      <header class="max-w-lg">
      

        <h1 class="mt-5 font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white text-[clamp(1.9rem,3vw,2.8rem)]">
          Construimos <span class="text-blue-700 dark:text-blue-400">espacios</span> con propósito
        </h1>

        <p class="mt-3 text-slate-700 dark:text-slate-300 text-[1.05rem] leading-relaxed">
          Residencial y comercial con calidad comprobada, seguridad en obra y transparencia total en cada proyecto.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#contacto" class="rounded-full px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition">
            Solicitar cotización
          </a>
          <a href="#proyectos" class="rounded-full px-6 py-2.5 border border-blue-600 text-blue-700 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-slate-900 transition">
            Ver proyectos
          </a>
        </div>

        <!-- Bullets pequeños y minimal -->
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li class="flex items-center gap-1.5"><span class="text-blue-600">•</span> 15+ años de experiencia</li>
          <li class="flex items-center gap-1.5"><span class="text-blue-600">•</span> Protocolos de seguridad</li>
          <li class="flex items-center gap-1.5"><span class="text-blue-600">•</span> Garantía estructural</li>
          <li class="flex items-center gap-1.5"><span class="text-blue-600">•</span> Presupuesto transparente</li>
        </ul>
      </header>

      <!-- Imagen lateral -->
      <figure class="hidden md:block relative rounded-3xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.45)]">
        <img
          src="/images/hero.avif"
          alt="Construcción moderna"
          width="1200" height="800"
          class="w-full h-[400px] object-cover transition-transform duration-700 hover:scale-[1.03]"
        />
        <figcaption class="absolute bottom-3 left-3 text-xs bg-white/85 text-slate-900 backdrop-blur px-3 py-1.5 rounded-full shadow-sm">
          Torre Andina • Tarapoto
        </figcaption>
      </figure>
    </div>
  </div>
</section>
