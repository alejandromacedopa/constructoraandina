---
/** Si prefieres importar el logo como asset (más robusto):
 *  import logoUrl from "../assets/logo.svg";
 *  y luego usa src={logoUrl} en <img>.
 */
const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#proceso',   label: 'Proceso' },
  { href: '#contacto',  label: 'Contacto' },
];
---
<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all">
  <div class="mx-auto max-w-[80rem] px-4 pt-3">
    <!-- barra -->
    <div class="h-14 rounded-2xl border bg-white/70 dark:bg-slate-950/65
                border-white/40 dark:border-white/10 backdrop-blur-md
                shadow-sm flex items-center gap-3 px-3 sm:px-4">

      <!-- Logo + nombre -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        
        <span class="hidden sm:block font-semibold tracking-tight">Constructora Andina</span>
      </a>

      <!-- Espaciador -->
      <div class="flex-1"></div>

      <!-- Nav desktop -->
      <nav class="hidden md:flex items-center gap-2">
        {links.map((l) => (
          <a href={l.href}
             class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700/90 dark:text-slate-200/90
                    hover:text-blue-700 dark:hover:text-blue-300
                    hover:bg-slate-900/5 dark:hover:bg-white/5
                    relative">
            <span class="after:absolute after:left-3 after:right-3 after:-bottom-0.5 after:h-[2px]
                           after:scale-x-0 after:bg-blue-600 after:transition-transform
                           hover:after:scale-x-100"></span>
            {l.label}
          </a>
        ))}
      </nav>

      <!-- CTA desktop -->
      <a href="#contacto"
         class="hidden md:inline-flex rounded-full px-4 py-2.5 bg-blue-600 text-white text-sm font-semibold
                hover:bg-blue-700 shadow-sm">
        Cotizar
      </a>

      <!-- Toggle móvil -->
      <button id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu"
              class="md:hidden ml-1 inline-flex items-center justify-center size-10 rounded-xl
                     hover:bg-slate-900/5 dark:hover:bg-white/5">
        <span class="sr-only">Abrir menú</span>
        <!-- icono hamburguesa -->
        <svg class="size-5 text-slate-800 dark:text-slate-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu"
       class="md:hidden pointer-events-none opacity-0 translate-y-[-6px] transition-all duration-200">
    <div class="mx-auto max-w-[80rem] px-4">
      <div class="mt-2 rounded-2xl border bg-white/90 dark:bg-slate-950/90
                  border-white/40 dark:border-white/10 backdrop-blur-md shadow-lg p-2">
        <nav class="flex flex-col">
          {links.map((l) => (
            <a href={l.href}
               class="px-3 py-3 rounded-xl text-[15px] font-medium text-slate-800 dark:text-slate-100
                      hover:bg-slate-900/5 dark:hover:bg-white/5">
              {l.label}
            </a>
          ))}
          <a href="#contacto"
             class="mt-1 rounded-xl px-3 py-3 bg-blue-600 text-white text-center font-semibold hover:bg-blue-700">
            Cotizar proyecto
          </a>
        </nav>
      </div>
    </div>
  </div>

  <!-- JS pequeñito: sombra al hacer scroll + toggle del menú -->
  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;

      // sombra sutil al scrollear
      const header = document.getElementById('site-header');
      const onScroll = () => {
        const scrolled = window.scrollY > 4;
        header.style.filter = scrolled ? 'drop-shadow(0 8px 24px rgba(2,6,23,.08))' : 'none';
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // menú móvil
      const btn = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-menu');
      const open = (v) => {
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
        menu.style.pointerEvents = v ? 'auto' : 'none';
        menu.style.opacity = v ? '1' : '0';
        menu.style.transform = v ? 'translateY(0)' : 'translateY(-6px)';
      };
      let isOpen = false;
      btn?.addEventListener('click', () => { isOpen = !isOpen; open(isOpen); });
      // cerrar al navegar
      menu?.querySelectorAll('a')?.forEach(a => a.addEventListener('click', () => { isOpen = false; open(false); }));
    })();
  </script>
</header>
