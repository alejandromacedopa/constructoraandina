---
const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#proceso',   label: 'Proceso' },
  { href: '#contacto',  label: 'Contacto' },
];
---
<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-[80rem] px-4 pt-3">
    <div class="h-14 rounded-xl border bg-white/70 dark:bg-slate-950/65
                border-white/40 dark:border-white/10 backdrop-blur-md
                flex items-center gap-3 px-3 sm:px-4 transition-shadow">
      <!-- Logo + marca -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img
          src="/images/logo.png"
          alt="Constructora Andina"
          class="h-8 w-auto block"
          width="160" height="40"
          loading="eager" decoding="async" fetchpriority="high"
        />
        <span class="hidden sm:block font-semibold tracking-tight">Constructora Andina</span>
      </a>

      <div class="flex-1" />

      <!-- Navegación desktop -->
      <nav class="hidden md:flex items-center gap-1.5">
        {links.map((l) => (
          <a
            href={l.href}
            class="px-3 py-2 rounded-lg text-sm font-medium text-slate-700/90 dark:text-slate-200/90
                   hover:text-blue-700 dark:hover:text-blue-300 hover:bg-slate-900/5 dark:hover:bg-white/5
                   relative data-[active=true]:text-blue-700 dark:data-[active=true]:text-blue-300"
          >
            <span
              class="absolute left-3 right-3 -bottom-[2px] h-[2px] origin-left scale-x-0 bg-blue-600 transition-transform
                     group-[&]:hover:scale-x-100 data-[active=true]:scale-x-100"
            />
            {l.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <a href="#contacto"
         class="hidden md:inline-flex rounded-full px-4 py-2.5 bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
        Cotizar
      </a>

      <!-- Toggle móvil -->
      <button id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu"
              class="md:hidden ml-1 inline-flex items-center justify-center size-10 rounded-lg
                     hover:bg-slate-900/5 dark:hover:bg-white/5">
        <span class="sr-only">Abrir menú</span>
        <svg class="size-5 text-slate-800 dark:text-slate-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu"
       class="md:hidden pointer-events-none opacity-0 -translate-y-1 transition-all duration-200">
    <div class="mx-auto max-w-[80rem] px-4">
      <div class="mt-2 rounded-xl border bg-white/90 dark:bg-slate-950/90
                  border-white/40 dark:border-white/10 backdrop-blur-md shadow-lg p-2">
        <nav class="flex flex-col">
          {links.map((l) => (
            <a href={l.href}
               class="px-3 py-3 rounded-lg text-[15px] font-medium text-slate-800 dark:text-slate-100
                      hover:bg-slate-900/5 dark:hover:bg-white/5">
              {l.label}
            </a>
          ))}
          <a href="#contacto"
             class="mt-1 rounded-lg px-3 py-3 bg-blue-600 text-white text-center font-semibold hover:bg-blue-700">
            Cotizar proyecto
          </a>
        </nav>
      </div>
    </div>
  </div>

  <!-- JS: sombra on scroll + toggle móvil + link activo -->
  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;

      const header = document.getElementById('site-header');
      const onScroll = () => header.style.boxShadow =
        window.scrollY > 6 ? '0 8px 30px -18px rgba(2,6,23,.25)' : 'none';
      addEventListener('scroll', onScroll, { passive: true }); onScroll();

      const btn  = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-menu');
      const open = (v) => {
        btn.setAttribute('aria-expanded', v ? 'true' : 'false');
        menu.style.pointerEvents = v ? 'auto' : 'none';
        menu.style.opacity = v ? '1' : '0';
        menu.style.transform = v ? 'translateY(0)' : 'translateY(-4px)';
      };
      let isOpen = false;
      btn?.addEventListener('click', () => { isOpen = !isOpen; open(isOpen); });
      menu?.querySelectorAll('a')?.forEach(a => a.addEventListener('click', () => { isOpen = false; open(false); }));

      // Resaltado del link activo según sección visible
      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
      const ids = navLinks.map(a => a.getAttribute('href')).filter(Boolean);
      const sections = ids.map(id => document.querySelector(id));
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            const id = '#' + e.target.id;
            const link = navLinks.find(a => a.getAttribute('href') === id);
            if (link) link.dataset.active = e.isIntersecting ? 'true' : 'false';
          });
        }, { threshold: 0.5 });
        sections.forEach(s => s && io.observe(s));
      }
    })();
  </script>
</header>
