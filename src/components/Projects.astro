---
const proyectos = [
  { title:'Torre Andina', img:'/images/proyectos/torre-andina.webp', city:'Tarapoto',  area:'7,500 m²', year:'2024' },
  { title:'Residencial El Pinar', img:'/images/proyectos/residencial-pinar.avif', city:'Moyobamba', area:'3,200 m²', year:'2023' },
  { title:'Centro Empresarial Norte', img:'/images/proyectos/centro-norte.webp', city:'Tarapoto',  area:'5,100 m²', year:'2022' },
];
---
<section id="proyectos" class="section">
  <div class="container">
    <div class="flex items-end justify-between mb-6">
      <h2 class="h2">Proyectos destacados</h2>
      <a href="#contacto" class="text-sm text-blue-700 dark:text-blue-300 hover:underline">¿Necesitas algo similar? →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {proyectos.map((p)=>(
        <div class="group relative rounded-2xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10 bg-white/70 dark:bg-white/5 backdrop-blur shadow transition hover:shadow-2xl hover:-translate-y-1 cursor-default select-none">
          <img src={p.img} alt={p.title} width="1200" height="800" loading="lazy" decoding="async" class="w-full h-64 object-cover transition group-hover:scale-[1.05]" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent transition-opacity group-hover:opacity-90"></div>
          <div class="absolute bottom-3 left-3 right-3 text-white">
            <h3 class="font-semibold text-lg leading-tight">{p.title}</h3>
            <p class="text-xs opacity-90">{p.city} • {p.area} • {p.year}</p>
          </div>
          <span class="absolute top-3 right-3 text-[11px] font-semibold bg-white/85 text-gray-800 px-2.5 py-0.5 rounded-full backdrop-blur">Vista general</span>
        </div>
      ))}
    </div>
  </div>
</section>
