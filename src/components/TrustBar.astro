---
const items = ['ISO 9001','ISO 45001','Colegio de Ingenieros','20+ Aliados'];
---
<section class="py-10">
  <div class="container grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
    {items.map((t)=>(
      <div class="rounded-xl border border-gray-200/70 dark:border-white/10 py-4 text-sm text-gray-600 dark:text-gray-300">{t}</div>
    ))}
  </div>
</section>
