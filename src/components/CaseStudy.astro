---
// src/components/CaseStudy.astro
const caso = {
  title: "Complejo Residencial El Pinar",
  reto: "Plazo agresivo y control riguroso de costos.",
  solucion: "Planificación por fases, control de metrados y supervisión diaria.",
  resultado: ["−12% variación de costos", "Entrega 2 semanas antes", "Satisfacción 98%"],
  img: "/images/proyectos/residencial-pinar.avif",
};
---
<section class="section">
  <div class="container grid md:grid-cols-2 gap-10 items-center">
    <figure class="rounded-2xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10">
      <img src={caso.img} alt={caso.title} class="w-full h-[360px] object-cover" loading="lazy" />
    </figure>
    <div>
      <h2 class="h2">Caso de estudio</h2>
      <h3 class="mt-2 font-semibold">{caso.title}</h3>
      <dl class="mt-4 space-y-3 text-sm">
        <div><dt class="font-semibold">Reto</dt><dd class="text-gray-600 dark:text-gray-300">{caso.reto}</dd></div>
        <div><dt class="font-semibold">Solución</dt><dd class="text-gray-600 dark:text-gray-300">{caso.solucion}</dd></div>
        <div><dt class="font-semibold">Resultados</dt><dd class="text-gray-600 dark:text-gray-300">{caso.resultado.join(" • ")}</dd></div>
      </dl>
      <a href="/proyectos/residencial-el-pinar" class="btn-outline mt-6 inline-flex">Leer completo</a>
    </div>
  </div>
</section>
