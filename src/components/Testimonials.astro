---
const items = [
  { name:'María R.', role:'Propietaria',  text:'Cumplieron plazos y el acabado superó expectativas.', img:'/images/testimonios/maria-r.webp' },
  { name:'Carlos T.', role:'Inversionista', text:'Comunicación clara y control de costos transparente.', img:'/images/testimonios/carlos-t.webp' },
];
---
<section class="section">
  <div class="container">
    <h2 class="h2 mb-8">Lo que dicen nuestros clientes</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {items.map((t)=>(
        <figure class="card p-6">
          <div class="flex items-center gap-3">
            <img src={t.img} alt={t.name} width="64" height="64" class="w-12 h-12 rounded-full object-cover" loading="lazy" decoding="async" />
            <figcaption><div class="font-semibold">{t.name}</div><div class="text-xs text-gray-500 dark:text-gray-400">{t.role}</div></figcaption>
          </div>
          <blockquote class="mt-4 text-gray-800 dark:text-gray-100">“{t.text}”</blockquote>
        </figure>
      ))}
    </div>
  </div>
</section>
